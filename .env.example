# Скопируйте в .env (файл не попадает в git) и задайте свои значения.

# --- База данных (обязательно) ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Первый HR-администратор: создаётся при первом запуске, если пользователей ещё нет.
# Пароль временный: при входе система попросит сменить его. После первого входа значения можно удалить.
CAREER_QUEST_BOOTSTRAP_HR_EMAIL=
CAREER_QUEST_BOOTSTRAP_HR_PASSWORD=

# --- Продакшн (deploy/compose.prod.yaml) ---
CAREER_QUEST_DOMAIN=career.example.kz
ACME_EMAIL=admin@example.kz
BACKUP_DIR=/var/backups/career-quest
BACKUP_KEEP_DAYS=14

# --- Режим отметки выполнения: approval (HR подтверждает) или instant (демо) ---
CAREER_QUEST_COMPLETION_MODE=approval

# --- Мониторинг: токен для GET /api/metrics (пусто = эндпоинт выключен) ---
CAREER_QUEST_METRICS_TOKEN=

# --- Необязательный GPT. Ключ хранится только на сервере. ---
OPENAI_API_KEY=
CAREER_QUEST_OPENAI_MODEL=gpt-4o-mini
CAREER_QUEST_AI_DAILY_LIMIT=20
